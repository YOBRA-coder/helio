# Set these in the environment of the machine that runs the worker and the web server (never commit secrets).

# Where per-user desks, accounts and history are kept. Must be shared by worker and web server.
HELIOS_DATA_DIR=./data

# REQUIRED. Long random string (32+ chars). Encrypts every user's saved Polymarket keys (AES-256-GCM).
# Lose it and saved keys are unreadable; leak it together with the data dir and keys are exposed.
HELIOS_MASTER_KEY=

# 1 = anyone can sign up. Set 0 after you have created your account(s).
HELIOS_ALLOW_SIGNUP=1
# 1 = mark session cookies Secure (set this when served over HTTPS).
HELIOS_COOKIE_SECURE=0

# Optional World Monitor (paid API plan). Leave empty to use free sources only.
WORLDMONITOR_API_KEY=
WORLDMONITOR_BASE_URL=https://api.worldmonitor.app
# 1 = let Fear & Greed nudge long-horizon probabilities by at most 2 points (scored separately). Default off.
HELIOS_CTX_TILT=0

# ---- Live trading (server-wide switch; each user adds their own keys on the Account page) ----
HELIOS_LIVE_ENABLED=0

# 1 = also generate practice (simulated) windows on the server desk. Default 0: real Polymarket markets only.
HELIOS_SIM_WINDOWS=0

# ---- Durable storage without a disk (Neon / any Postgres). Optional. ----
# Accounts, sessions, saved keys and desk state are checkpointed here so a restart or redeploy does not wipe them.
HELIOS_DATABASE_URL=
# How often (minutes) the desk state is saved. Keep it 15+ on Neon's free plan so the database can sleep.
HELIOS_CHECKPOINT_MIN=15

# Live BTC price from Coinbase's websocket (about 1s fresher than the 6s REST price). Set 0 to use REST only.
HELIOS_WS_FEED=1
