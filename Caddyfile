# Replace desk.example.com with your domain (its DNS A record must point at this server).
desk.example.com {
	encode zstd gzip

	# Hashed build assets never change: let browsers keep them forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}
}
